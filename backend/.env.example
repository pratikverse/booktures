DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/booktures
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=booktures
SKIP_DB_AUTOCREATE=false

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_MB=25

OLLAMA_ENABLED=True

# LLM_PROVIDER: ollama (local, default) or groq (free-tier cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=phi3
OLLAMA_TIMEOUT_SECONDS=180
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# IMAGE_PROVIDER: diffusers (local GPU/CPU, default), workers-ai (free-tier cloud,
# handles multi-character scenes noticeably better), or pollinations (free-tier cloud, keyless)
IMAGE_PROVIDER=diffusers
IMAGE_PRESET=balanced
DIFFUSION_MODEL=segmind/SSD-1B
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_WORKERS_AI_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# STORAGE_PROVIDER: local (default) or supabase or r2
STORAGE_PROVIDER=local
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=booktures
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=
