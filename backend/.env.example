DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/booktures
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=booktures
SKIP_DB_AUTOCREATE=false

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_MB=25

OLLAMA_ENABLED=True

# LLM_PROVIDER: ollama (local, default) or groq (free-tier cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=phi3
OLLAMA_TIMEOUT_SECONDS=180
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# IMAGE_PROVIDER: diffusers (local GPU/CPU, default) or pollinations (free-tier cloud)
IMAGE_PROVIDER=diffusers
IMAGE_PRESET=balanced
DIFFUSION_MODEL=segmind/SSD-1B
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
